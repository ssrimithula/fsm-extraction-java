digraph FSM {
graph [label=<Algorithm 1 (loop-unaware): invents loop edges<br/><font point-size="12">solid arrow = first time a state is reached, dashed red = returns to an already visited state</font>>, labelloc=t, fontsize=22, fontname=Helvetica, nodesep=0.45, ranksep=0.75, pad=0.3];
node [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a", fontname=Helvetica, fontsize=14, margin="0.14,0.08"];
edge [fontname=Helvetica, fontsize=12, color="#374151", arrowsize=0.8];
START [shape=circle, label="START", fillcolor="#86efac", color="#166534", width=0.75, fixedsize=true, fontsize=12];
"x=0" [label="x = 0"];
"x=1" [label="x = 1"];
"x=2" [label="x = 2"];
"x=3" [label="x = 3"];
"x=4" [label="x = 4"];
"x=5" [label="x = 5"];
"x=6" [label="x = 6"];
"x=7" [label="x = 7"];
"x=8" [label="x = 8"];
"x=9" [label="x = 9"];
"x=10" [label="x = 10"];
"x=11" [label="x = 11"];
"x=12" [label="x = 12"];
START -> "x=0";
"x=0" -> "x=1" [label="x"];
"x=1" -> "x=2" [label="x"];
"x=2" -> "x=3" [label="x"];
"x=3" -> "x=2" [label="x", style=dashed, color="#dc2626", fontcolor="#dc2626"];
"x=2" -> "x=4" [label="x"];
"x=4" -> "x=3" [label="x", style=dashed, color="#dc2626", fontcolor="#dc2626"];
"x=4" -> "x=5" [label="x"];
"x=5" -> "x=6" [label="x"];
"x=6" -> "x=5" [label="x", style=dashed, color="#dc2626", fontcolor="#dc2626"];
"x=6" -> "x=7" [label="x"];
"x=7" -> "x=8" [label="x"];
"x=8" -> "x=7" [label="x", style=dashed, color="#dc2626", fontcolor="#dc2626"];
"x=8" -> "x=9" [label="x"];
"x=9" -> "x=10" [label="x"];
"x=10" -> "x=11" [label="x"];
"x=11" -> "x=10" [label="x", style=dashed, color="#dc2626", fontcolor="#dc2626"];
"x=11" -> "x=12" [label="x"];
"x=12" -> "x=9" [label="x", style=dashed, color="#dc2626", fontcolor="#dc2626"];
"x=12" -> "x=0" [label="x", style=dashed, color="#dc2626", fontcolor="#dc2626"];
}
