digraph FSM {
graph [label=<Algorithm 2 (loop-aware): the paper's loop example, no invented cycles<br/><font point-size="12">colour = which loop the state belongs to (hidden loop id of Algorithm 2); xN = times the arrow was taken; dashed red = back to an earlier state</font>>, labelloc=t, fontsize=22, fontname=Helvetica, nodesep=0.45, ranksep=0.6, pad=0.3];
node [shape=box, style="rounded,filled", color="#1e3a8a", fontname=Helvetica, fontsize=14, margin="0.14,0.08"];
edge [fontname=Helvetica, fontsize=12, color="#374151", arrowsize=0.8];
n0 [shape=circle, label="START", fillcolor="#86efac", color="#166534", width=0.75, fixedsize=true, fontsize=12];
n1 [label="x = 0", fillcolor="#ffffff"];
n2 [label="x = 1", fillcolor="#ffffff"];
n3 [label="x = 2", fillcolor="#ffffff"];
n4 [label="x = 3", fillcolor="#dbeafe"];
n5 [label="x = 2", fillcolor="#dbeafe"];
n6 [label="x = 4", fillcolor="#dbeafe"];
n7 [label="x = 5", fillcolor="#fde68a"];
n8 [label="x = 6", fillcolor="#fde68a"];
n9 [label="x = 7", fillcolor="#bbf7d0"];
n10 [label="x = 8", fillcolor="#bbf7d0"];
n11 [label="x = 9", fillcolor="#fbcfe8"];
n12 [label="x = 10", fillcolor="#ddd6fe"];
n13 [label="x = 11", fillcolor="#ddd6fe"];
n14 [label="x = 12", fillcolor="#fbcfe8"];
n0 -> n1 [label="x1"];
n1 -> n2 [label="x1"];
n2 -> n3 [label="x1"];
n3 -> n4 [label="x1"];
n4 -> n5 [label="x3"];
n5 -> n6 [label="x3"];
n6 -> n4 [label="x2", style=dashed, color="#dc2626", fontcolor="#dc2626"];
n6 -> n7 [label="x1"];
n7 -> n8 [label="x2"];
n8 -> n7 [label="x1", style=dashed, color="#dc2626", fontcolor="#dc2626"];
n8 -> n9 [label="x1"];
n9 -> n10 [label="x2"];
n10 -> n9 [label="x1", style=dashed, color="#dc2626", fontcolor="#dc2626"];
n10 -> n11 [label="x1"];
n11 -> n12 [label="x2"];
n12 -> n13 [label="x6"];
n13 -> n12 [label="x4", style=dashed, color="#dc2626", fontcolor="#dc2626"];
n13 -> n14 [label="x2"];
n14 -> n11 [label="x1", style=dashed, color="#dc2626", fontcolor="#dc2626"];
n14 -> n1 [label="x1", style=dashed, color="#dc2626", fontcolor="#dc2626"];
}
