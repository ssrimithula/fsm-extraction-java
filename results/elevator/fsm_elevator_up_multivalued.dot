digraph FSM {
graph [label=<Elevator going up: floor abstracted to &lt;3 / 3-6 / &gt;6 (multivalued)<br/><font point-size="12">solid arrow = first time a state is reached, dashed red = returns to an already visited state</font>>, labelloc=t, fontsize=22, fontname=Helvetica, nodesep=0.45, ranksep=0.75, pad=0.3];
node [shape=box, style="rounded,filled", fillcolor="#dbeafe", color="#1e3a8a", fontname=Helvetica, fontsize=14, margin="0.14,0.08"];
edge [fontname=Helvetica, fontsize=12, color="#374151", arrowsize=0.8];
START [shape=circle, label="START", fillcolor="#86efac", color="#166534", width=0.75, fixedsize=true, fontsize=12];
"d=up | f=<3" [label="d = up\nf = <3"];
"d=up | f=3-6" [label="d = up\nf = 3-6"];
"d=up | f=>6" [label="d = up\nf = >6"];
START -> "d=up | f=<3";
"d=up | f=<3" -> "d=up | f=3-6" [label="f"];
"d=up | f=3-6" -> "d=up | f=>6" [label="f"];
}
